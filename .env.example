APP_URL=https://enoch.schaefchens.de
APP_ENV=production
HETZNER_CLOUD_TOKEN=
# Generate both with: php bin/console init
SETUP_KEY=
CRON_KEY=
# Absolute path is optional; default is PROJECT/var.
ENOCH_DATA_DIR=
# Separate, restricted SSH key, generated with: php bin/console ssh-key
NEXTCLOUD_SSH_FINGERPRINT=
# Existing game controller credentials remain server-side.
GAME_SERVER_ADMIN_KEY=
GAME_IDLE_CHECK_INTERVAL=3600
