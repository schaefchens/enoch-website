#!/usr/bin/env python3
"""Run the local lifecycle scripts with this project's private Hetzner token."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parents[2]
values = {}
for line in (root / '.env').read_text().splitlines():
    if '=' not in line or line.lstrip().startswith('#'):
        continue
    name, value = line.split('=', 1)
    value = value.strip()
    if len(value) >= 2 and value[0] in "\"'" and value[-1] == value[0]:
        value = value[1:-1]
    values[name.strip()] = value
allowed = {'nextcloud': 'nextcloud_create_n_delete', 'hpb': 'highperformancebackend_create_n_delete'}
if len(sys.argv) < 2 or sys.argv[1] not in allowed:
    sys.exit('Usage: infrastructure/local/run nextcloud|hpb [arguments]')
env = os.environ.copy()
env['HCLOUD_TOKEN'] = values.get('HETZNER_CLOUD_TOKEN', '')
if not env['HCLOUD_TOKEN']:
    sys.exit('Set HETZNER_CLOUD_TOKEN in the project .env.')
script = root / 'infrastructure/local' / allowed[sys.argv[1]]
os.execve(str(script), [str(script), *sys.argv[2:]], env)
